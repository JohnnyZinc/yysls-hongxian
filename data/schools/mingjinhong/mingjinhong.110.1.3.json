    "O2": "=((($AO2+$AP2)/2*$AI2+$AJ2)*(1+$AQ2)*(1+$AR2)+(($AT2+$AU2)/2*IF($G$1=\"鸣金\",$AK2,$AI2)+IF($G$1=\"鸣金\",$AL2*1.5,0))*(1+$AV2)*(1+$AW2)+(($AX2+$AY2)/2*IF($G$1=\"裂石\",$AK2,$AI2)+IF($G$1=\"裂石\",$AL2*1.5,0))*(1+$AZ2)*(1+$BA2)+(($BB2+$BC2)/2*IF($G$1=\"牵丝\",$AK2,$AI2)+IF($G$1=\"牵丝\",$AL2*1.5,0))*(1+$BD2)*(1+$BE2)+(($BF2+$BG2)/2*IF($G$1=\"破竹\",$AK2,$AI2)+IF($G$1=\"破竹\",$AL2*1.5,0))*(1+$BH2)*(1+$BI2))*(1+$AM2)*$Q2*(1+IF(VLOOKUP($R2,武学奇术!$A:$ZZ,30,FALSE)=\"蓄力技\",$B$21,0))*(1+$BR2)",
